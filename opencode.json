{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "C:/Users/German Gonzalez/Documents/Python Nuevo/RemoverAudioAI"],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=https://dqxqjjttobctnmnkkkgd.supabase.co",
      "headers": {
        "Authorization": "Bearer ${env:SUPABASE_KEY}"
      },
      "enabled": true
    }
  }
}